<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Cilica.Metadata.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Execute the exact owned parser/classifier only in the authored managed oracle. -->
    <Compile Include="../../library/Cilica.Core/BooleanParsing.cs" Link="OwnedBooleanParsing.cs" />
    <Compile Include="../../library/Cilica.Core/UnicodeWhitespace.cs" Link="OwnedUnicodeWhitespace.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../docs/compatibility/alchemy-gap-ledger.json" Link="compatibility-gap-ledger.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/Cilica.LibraryBuild/Cilica.LibraryBuild.csproj" />
    <ProjectReference Include="..\..\src\Cilica.Metadata\Cilica.Metadata.csproj" />
    <ProjectReference Include="..\..\src\Cilica.Compiler\Cilica.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Cilica.Cli\Cilica.Cli.csproj" />
    <!-- Fixtures are inspected as files; they are copied to the output directory but never loaded. -->
    <ProjectReference Include="..\Fixtures\Cilica.Fixtures.Basic\Cilica.Fixtures.Basic.csproj" />
    <ProjectReference Include="..\Fixtures\Cilica.Fixtures.Forwarding\Cilica.Fixtures.Forwarding.csproj" />
    <ProjectReference Include="..\Fixtures\Cilica.Fixtures.ControlFlow\Cilica.Fixtures.ControlFlow.csproj" />
    <!-- Authored executable probes run only in the test oracle/native harness. -->
    <ProjectReference Include="..\Fixtures\Cilica.Fixtures.Execution\Cilica.Fixtures.Execution.csproj" />
    <!-- Build the example helper; run its authored oracle only in a separate process. -->
    <ProjectReference Include="..\..\examples\Primitive\Prepare\Prepare.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\examples\Objects\Prepare\Prepare.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../library/Cilica.Core/UnicodeOrdinalUpper.cs" Link="UnicodeOrdinalUpper.cs" />
    <Compile Include="../../library/Cilica.Core/OrdinalIgnoreCaseText.cs" Link="OrdinalIgnoreCaseText.cs" />
    <Compile Include="../../library/Cilica.Core/UnicodeSimpleLower.cs" Link="UnicodeSimpleLower.cs" />
  </ItemGroup>
</Project>
