import UIKit

typealias Runtime = @MODULE@Runtime
typealias Host = @MODULE@SceneHost

@MainActor protocol SceneScenario {
    func start(_ host: Host, _ scene: UIScene) async throws
    func background(_ host: Host, cycle: Int) async throws
    func resume(_ host: Host, cycle: Int) async throws
    func finish(_ host: Host) async throws
}

@MainActor let cycleLimit: Int = {
    let arguments = ProcessInfo.processInfo.arguments
    guard let index = arguments.firstIndex(of: "--cycles"), index + 1 < arguments.count,
          let count = Int(arguments[index + 1]), (1...10).contains(count) else { return 3 }
    return count
}()

@MainActor func report(_ text: String) {
    FileHandle.standardOutput.write(Data((text + "\n").utf8))
}

@main @MainActor final class ProbeApp: UIResponder, UIApplicationDelegate {
    func application(_ application: UIApplication, configurationForConnecting session: UISceneSession,
                     options: UIScene.ConnectionOptions) -> UISceneConfiguration {
        let config = UISceneConfiguration(name: "Probe", sessionRole: session.role)
        config.delegateClass = ProbeScene.self
        return config
    }
}

@MainActor final class ProbeScene: UIResponder, UIWindowSceneDelegate {
    var window: UIWindow?
    private var host: Host?
    private let scenario: any SceneScenario = Scenario()
    private var cycle = 1
    private var phase = 0
    private var checking = false
    private var backgrounded = false
    private var isCover: Bool { Bundle.main.object(forInfoDictionaryKey: "CilicaCover") as? Bool == true }

    func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options: UIScene.ConnectionOptions) {
        guard let windowScene = scene as? UIWindowScene else { return }
        let window = UIWindow(windowScene: windowScene)
        let controller = UIViewController()
        controller.view.backgroundColor = .systemBackground
        let label = UILabel(frame: CGRect(x: 24, y: 100, width: 330, height: 120))
        label.numberOfLines = 0
        label.text = isCover ? "Cilica lifecycle test cover" : "Cilica lifecycle test\nSee the test log for results."
        controller.view.addSubview(label)
        window.rootViewController = controller; window.makeKeyAndVisible(); self.window = window
        guard !isCover else { return }
        Task {
            do {
                var options = Runtime.Options()
                options.collectBeforeAllocation = ProcessInfo.processInfo.arguments.contains("--stress")
                options.handleLimit = 8
                let opened = try await Host.open(for: scene, options: options)
                host = opened
                opened.refreshSceneState()
                try await opened.synchronize()
                checkActive(scene)
            } catch { report("FAIL startup \(error)") }
        }
    }
    func sceneDidBecomeActive(_ scene: UIScene) {
        guard !isCover else { return }
        report("UIKIT ACTIVE")
        host?.sceneDidBecomeActive(scene)
        checkActive(scene)
    }
    func sceneWillResignActive(_ scene: UIScene) {
        guard !isCover else { return }
        host?.sceneWillResignActive(scene)
        precondition(host?.isActive != true)
        report("UIKIT INACTIVE")
    }
    func sceneDidEnterBackground(_ scene: UIScene) {
        guard !isCover else { return }
        host?.sceneDidEnterBackground(scene)
        backgrounded = true
        report("UIKIT BACKGROUND")
        guard phase == 1, let host else { return }
        let backgroundCycle = cycle
        Task {
            do {
                try await host.synchronize()
                let state = await host.runtime.lifecycle
                precondition(state == .paused && !host.isActive)
                do { _ = try await host.invoke(999); fatalError("inactive UI admitted") }
                catch Runtime.Failure.paused {}
                try await scenario.background(host, cycle: backgroundCycle)
                report("PAUSED cycle=\(backgroundCycle)")
            } catch { report("FAIL background \(error)") }
        }
    }
    func sceneDidDisconnect(_ scene: UIScene) {
        host?.sceneDidDisconnect(scene)
        report("UIKIT DISCONNECTED")
    }
    private func checkActive(_ scene: UIScene) {
        guard !checking, scene.activationState == .foregroundActive, let host else { return }
        checking = true
        Task {
            defer { checking = false }
            do {
                try await host.synchronize()
                guard host.isActive else { return }
                if phase == 0 {
                    try await scenario.start(host, scene)
                    phase = 1
                    report("READY cycle=\(cycle)")
                } else if phase == 1 && backgrounded {
                    try await scenario.resume(host, cycle: cycle)
                    report("RESUMED cycle=\(cycle)")
                    if cycle < cycleLimit {
                        cycle += 1
                        backgrounded = false
                        report("READY cycle=\(cycle)")
                    } else {
                        try await scenario.finish(host)
                        try await disconnectChecks(host, scene)
                        phase = 2
                        report("PASS UIKit scene lifecycle: cycles=\(cycleLimit), ordered transitions and disconnect cleanup")
                    }
                }
            } catch { report("FAIL active \(error)") }
        }
    }
    private func disconnectChecks(_ host: Host, _ scene: UIScene) async throws {
        // Forwarded disconnect is terminal even if an active event follows it.
        host.sceneWillResignActive(scene)
        host.sceneDidBecomeActive(scene)
        host.sceneDidDisconnect(scene)
        host.sceneDidBecomeActive(scene)
        precondition(!host.isActive)
        try await host.synchronize()
        precondition(host.isClosed)
        do { _ = try await host.invoke(999); fatalError("disconnect reopened host") }
        catch Runtime.Failure.closed {}
        try await host.close()
    }
}
