import Foundation

typealias Runtime = @MODULE@Runtime

@main struct SessionChecks {
    static func handle(_ outcome: Runtime.Outcome) -> Runtime.Handle {
        guard outcome.fault == nil, case .handle(let handle) = outcome.value, let handle else { fatalError("Expected lease") }
        return handle
    }
    static func fields(_ outcome: Runtime.Outcome) -> [Runtime.Value] {
        guard outcome.fault == nil, case .record(1, let fields) = outcome.value else { fatalError("Expected record") }
        return fields
    }
    static func lifecycleChecks(stress: Bool) async throws {
        var options = Runtime.Options(); options.collectBeforeAllocation = stress; options.handleLimit = 8
        let runtime = try await Runtime.open(options: options)
        let other = try await Runtime.open(options: options)
        let initialState = await runtime.lifecycle
        precondition(initialState == .active)
        let text = try await runtime.importUTF16([65, 0, 0xd800])
        let session = handle(try await runtime.invoke(1, arguments: [.handle(text)]))
        let disposable = try await runtime.clone(session)
        let failure = try await runtime.invoke(2, arguments: [.handle(session), .int32(-1)], captureException: true)
        precondition(failure.fault?.code == 13)
        let exception = failure.exception!

        let screen = try await runtime.pause()
        let application = try await runtime.pause()
        let pausedState = await runtime.lifecycle
        precondition(pausedState == .paused)
        do { _ = try await runtime.invoke(2, arguments: [.handle(session), .int32(99)]); fatalError("paused mutation admitted") }
        catch Runtime.Failure.paused {}
        // Admission precedes schema/handle checks, including malformed requests.
        do { _ = try await runtime.invoke(999); fatalError("paused export admitted") }
        catch Runtime.Failure.paused {}
        do { _ = try await runtime.importUTF16([]); fatalError("paused import admitted") }
        catch Runtime.Failure.paused {}
        do { _ = try await runtime.clone(session); fatalError("paused clone admitted") }
        catch Runtime.Failure.paused {}
        let copied = try await runtime.copyUTF16(text)
        precondition(copied == [65, 0, 0xd800])
        let details = try await runtime.exceptionDetails(exception)
        precondition(details.message == Array("negative delta".utf16))
        try await runtime.release(exception)
        try await runtime.release(text)
        try await runtime.release(disposable)

        let foreign = try await other.pause()
        do { try await runtime.resume(foreign); fatalError("foreign pause admitted") }
        catch Runtime.Failure.invalidPause {}
        try await runtime.resume(screen)
        do { try await runtime.resume(screen); fatalError("consumed pause admitted") }
        catch Runtime.Failure.invalidPause {}
        do { _ = try await runtime.invoke(3, arguments: [.handle(session)]); fatalError("nested pause lost") }
        catch Runtime.Failure.paused {}
        try await runtime.resume(application)
        let resumed = fields(try await runtime.invoke(3, arguments: [.handle(session)]))
        precondition(resumed == [.int32(0), .integer64(9007199254740993), .int32(3)])
        _ = try await runtime.invoke(2, arguments: [.handle(session), .int32(1)])

        // A task submitted earlier may run on either side of the barrier. Count
        // successful mutations and prove every rejected command had no effect.
        let (barrier, accepted) = try await withThrowingTaskGroup(of: Int.self, returning: (Runtime.Pause, Int).self) { group in
            for _ in 0..<24 { group.addTask {
                do {
                    let result = try await runtime.invoke(2, arguments: [.handle(session), .int32(1)])
                    precondition(result.fault == nil)
                    return 1
                } catch Runtime.Failure.paused { return 0 }
            } }
            let barrier = try await runtime.pause()
            var accepted = 0
            for try await count in group { accepted += count }
            return (barrier, accepted)
        }
        do { _ = try await runtime.invoke(2, arguments: [.handle(session), .int32(99)]); fatalError("barrier lost") }
        catch Runtime.Failure.paused {}
        try await runtime.resume(barrier)
        let actual = fields(try await runtime.invoke(3, arguments: [.handle(session)]))
        precondition(actual == [.int32(Int32(1 + accepted)), .integer64(9007199254740994 + UInt64(accepted)), .int32(Int32(5 + 2 * accepted))])
        let closing = try await runtime.pause()
        // A stale token cannot remove a newer hold, even on the same runtime.
        do { try await runtime.resume(barrier); fatalError("stale pause resumed new hold") }
        catch Runtime.Failure.invalidPause {}
        let stillPaused = await runtime.lifecycle
        precondition(stillPaused == .paused)
        try await runtime.close(); try await runtime.close()
        let closedState = await runtime.lifecycle
        precondition(closedState == .closed)
        do { try await runtime.resume(closing); fatalError("resume reopened closed runtime") }
        catch Runtime.Failure.closed {}
        do { _ = try await runtime.pause(); fatalError("closed pause admitted") }
        catch Runtime.Failure.closed {}
        do { _ = try await runtime.invoke(999); fatalError("closed export admitted") }
        catch Runtime.Failure.closed {}
        do { _ = try await runtime.copyUTF16(text); fatalError("closed copy admitted") }
        catch Runtime.Failure.closed {}

        // Pause bookkeeping is bounded and exhaustion preserves existing holds.
        var holds = [foreign]
        for _ in 1..<64 { holds.append(try await other.pause()) }
        do { _ = try await other.pause(); fatalError("pause quota ignored") }
        catch Runtime.Failure.pauseLimit {}
        for hold in holds { try await other.resume(hold) }
        let otherState = await other.lifecycle
        precondition(otherState == .active)
        try await other.close()
    }
    static func main() async throws {
        for stress in [false, true] {
            try await lifecycleChecks(stress: stress)
            var options = Runtime.Options(); options.collectBeforeAllocation = stress; options.handleLimit = 8
            let runtime = try await Runtime.open(options: options)
            let other = try await Runtime.open(options: options)
            let record = Runtime.Value.record(1, [.int32(-7), .integer64(UInt64.max), .int32(Int32.min)])
            let echoed = try await runtime.invoke(5, arguments: [record])
            precondition(echoed.value == record && echoed.fault == nil)
            do { _ = try await runtime.invoke(5, arguments: [.record(99, [])]); fatalError("bad record admitted") }
            catch Runtime.Failure.invalidArguments {}
            let text = try await runtime.importUTF16([65, 0, 0xd800])
            let session = handle(try await runtime.invoke(1, arguments: [.handle(text)]))
            try await runtime.release(text)
            let alias = try await runtime.clone(session)
            try await runtime.release(session)
            do { _ = try await runtime.invoke(3, arguments: [.handle(session)]); fatalError("released handle admitted") }
            catch Runtime.Failure.invalidHandle {}
            do { _ = try await other.invoke(3, arguments: [.handle(alias)]); fatalError("foreign handle admitted") }
            catch Runtime.Failure.invalidHandle {}
            do { _ = try await runtime.invoke(2, arguments: [.handle(alias), .integer64(1)]); fatalError("bad shape admitted") }
            catch Runtime.Failure.invalidArguments {}
            // Concurrent submissions are serialized; ordering between tasks is not promised.
            try await withThrowingTaskGroup(of: Void.self) { group in
                for _ in 0..<24 { group.addTask {
                    let result = try await runtime.invoke(2, arguments: [.handle(alias), .int32(1)], captureException: true)
                    precondition(result.fault == nil && result.exception == nil)
                } }
                try await group.waitForAll()
            }
            let view = fields(try await runtime.invoke(3, arguments: [.handle(alias)]))
            precondition(view == [.int32(24), .integer64(9007199254741017), .int32(51)])
            let saved = handle(try await runtime.invoke(4, arguments: [.handle(alias)]))
            do { _ = try await runtime.copyUTF16(saved, maximumUnits: 1); fatalError("copy bound ignored") }
            catch Runtime.Failure.copyLimit {}
            let failure = try await runtime.invoke(2, arguments: [.handle(alias), .int32(-1)], captureException: true)
            precondition(failure.fault?.code == 13 && failure.fault?.imageHash.count == 64)
            let exception = failure.exception!
            _ = try await runtime.invoke(2, arguments: [.handle(alias), .int32(2)])
            let details = try await runtime.exceptionDetails(exception)
            precondition(details.message == Array("negative delta".utf16) && details.typeName == Array("System.InvalidOperationException".utf16))
            precondition(details.typeToken != 0 && details.typeImageHash.count == 64)
            try await runtime.release(exception)
            let copied = try await runtime.copyUTF16(saved)
            precondition(copied == [65, 0, 0xd800] + Array(repeating: [UInt16(58), UInt16(49)], count: 24).flatMap { $0 })
            try await runtime.release(saved)
            try await runtime.release(alias)
            try await runtime.close(); try await runtime.close(); try await other.close()
            do { _ = try await runtime.importUTF16([]); fatalError("closed runtime admitted") }
            catch Runtime.Failure.closed {}
            precondition(copied[2] == 0xd800)
        }
        // Closing races with submitted work safely: each operation either finishes
        // before close or receives closed; it never enters freed native storage.
        let runtime = try await Runtime.open()
        try await withThrowingTaskGroup(of: Void.self) { group in
            for _ in 0..<12 { group.addTask {
                do { let h = try await runtime.importUTF16([1]); try await runtime.release(h) }
                catch Runtime.Failure.closed {}
            } }
            group.addTask { try await runtime.close() }
            try await group.waitForAll()
        }
        var emptyOptions = Runtime.Options(); emptyOptions.handleLimit = 0
        let empty = try await Runtime.open(options: emptyOptions)
        do { _ = try await empty.importUTF16([]); fatalError("handle quota ignored") }
        catch Runtime.Failure.native(5) {}
        try await empty.close()
        print("PASS Swift serialized sessions: 48 concurrent updates, UTF16, faults, ownership, close race and scoped pause barriers")
    }
}
