+using Xunit;
+namespace Cilica.Metadata.Tests;
+public sealed class CompactDictionaryTests
+{
+    private static readonly Lazy<Task<ManagedExceptionIrProgram[]>> Programs = new(() =>
+        CoreLibraryBuildTests.TranslateFixtures(typeof(CompactDictionaryProbe), ["Reentry", "ReferenceReentry", "Packed", "Growth"]));
+
+    [Theory] [InlineData(false)] [InlineData(true)]
+    public async Task Captured_arrays_preserve_reentrant_callbacks_and_value_reads(bool optimized)
+    {
+        var programs = await Programs.Value;
+        await IntegerObjectTranslationTests.VerifyTranslated(optimized,
+            [("Reentry", programs[0], CompactDictionaryProbe.Reentry)],
+            (from mode in Enumerable.Range(0, 12) from op in Enumerable.Range(0, 6) select (mode, op)).ToArray());
+        await IntegerObjectTranslationTests.VerifyTranslated(optimized,
+            [("ReferenceReentry", programs[1], CompactDictionaryProbe.ReferenceReentry)],
+            Enumerable.Range(0, 4).Select(mode => (mode, 0)).ToArray());
+    }
+
+    [Theory] [InlineData(false)] [InlineData(true)]
+    public async Task Entries_need_no_per_insertion_allocation_with_spare_capacity(bool optimized)
+    {
+        var program = (await Programs.Value)[2]; var flow = program.Flow.Flow.Flow;
+        var artifact = ObjectCppEmitter.EmitExceptions(ValueScalarLowering.LowerExceptions(program));
+        string Symbol(string name) {
+            var method = flow.Methods.Single(m => m.Source.Name == "Cilica.Fixtures.Execution.CompactDictionaryProbe::" + name);
+            return "cilica_m_" + method.Source.ContentHash + "_" + method.Source.Token.ToString("x8", CultureInfo.InvariantCulture);
+        }
+        string source = artifact.Text + $$"""
+            #include <cassert>
+            using namespace {{artifact.EntryPoint[..^4]}}_closure;
+            static unsigned allocations;
+            static void observe(Context&) noexcept { ++allocations; }
+            int main() {
+                Instance heap; heap.collect_before_allocation = true; Context c(heap);
+                assert(prepare_exceptions(c) == 0);
+                Object* map = nullptr; Frame frame; RootScope roots(c, frame, &map, 1);
+                map = {{Symbol("CreatePacked")}}(c, nullptr);
+                assert(map && c.pending == 0 && collect(c).status == MarkStatus::complete);
+                const auto before = heap.count; const auto bytes = heap.bytes;
