+            var comparer = new CompactReentryComparer();
+            var map = new Dictionary<int, int>(comparer); comparer.Owner = map;
+            for (int i = 1; i <= 3; ++i) map.Add(i, i * 11);
+            comparer.Mode = mode % 6; comparer.OnHash = mode / 6; comparer.Armed = 1;
+            int value = 37, found = 0;
+            try
+            {
+                if (operation == 0) found = map.TryGetValue(1, out value) ? 1 : 2;
+                if (operation == 1) found = map.ContainsKey(1) ? 3 : 4;
+                if (operation == 2) { value = map[1]; found = 5; }
+                if (operation == 3) { map[1] = 91; found = 6; }
