+                Armed = 0;
+                if (Mode == 0) Owner.Remove(1);
+                if (Mode == 1) Owner.Clear();
+                if (Mode == 2) { for (int i = 4; i < 9; ++i) Owner.Add(i, new ValueVectorBox(i)); Owner[1] = new ValueVectorBox(71); }
+                if (Mode == 3) Owner[1] = new ValueVectorBox(71);
+            }
+            return left == right;
+        }
+    }
+    public static class CompactDictionaryProbe
+    {
+        public static int Reentry(int mode, int operation)
