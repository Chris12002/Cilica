+    public sealed class CompactReentryComparer : IEqualityComparer<int>
+    {
+        public Dictionary<int, int> Owner;
+        public int Mode, Armed, OnHash, Calls;
+        public int GetHashCode(int value) { if (OnHash != 0) Change(); return value; }
+        public bool Equals(int left, int right) { if (OnHash == 0) Change(); return left == right; }
+        private void Change()
+        {
+            if (Armed == 0) return;
+            Armed = 0; Calls++;
+            if (Mode == 1) Owner[1] = 71;
+            if (Mode == 2) Owner.Remove(1);
+            if (Mode == 3) Owner.Clear();
+            if (Mode == 4) { for (int i = 4; i < 9; ++i) Owner.Add(i, i * 11); Owner[1] = 71; }
+            if (Mode == 5) throw new InvalidOperationException("callback");
+        }
+    }
+    public sealed class CompactReferenceComparer : IEqualityComparer<int>
+    {
+        public Dictionary<int, ValueVectorBox> Owner;
+        public int Mode, Armed;
+        public int GetHashCode(int value) => value;
+        public bool Equals(int left, int right)
+        {
+            if (Armed != 0)
