<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9</LangVersion><DefineConstants>$(ReferenceDefines)</DefineConstants>
    <Nullable>disable</Nullable><CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SegmentCompositionProbe.cs" /><Compile Include="SegmentReferenceCases.cs" />
    <Compile Include="template/ProjectData~/Assets/SegmentUnityHarness.cs" />
    <Compile Include="template/ProjectData~/Assets/Editor/SegmentReferenceBuild.cs" Condition="'$(EditorReference)' == 'true'" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManaged)/UnityEngine/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(UnityManaged)/UnityEngine/UnityEngine.JSONSerializeModule.dll</HintPath></Reference>
    <Reference Include="UnityEditor.CoreModule" Condition="'$(EditorReference)' == 'true'"><HintPath>$(UnityManaged)/UnityEngine/UnityEditor.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
